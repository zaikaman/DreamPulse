# ==============================================================================
# DreamPulse - Backend Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Allowed CORS origins (comma-separated, e.g. https://dreampulse.vercel.app or * for all)
FRONTEND_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. Security & Operator Admin
# ------------------------------------------------------------------------------
# Secret token required to authorize administrative operator endpoints (e.g., /agents/toggle, /agents/config)
OPERATOR_ADMIN_SECRET=your-secure-32-byte-hex-admin-secret

# ------------------------------------------------------------------------------
# 3. Supabase PostgreSQL & Realtime
# ------------------------------------------------------------------------------
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...<your-service-role-key>
SUPABASE_ANON_KEY=eyJhbGciOi...<your-anon-key>
# Supabase JWT Secret (Dashboard > Settings > API > JWT Secret) — required for
# wallet EIP-712 → Supabase JWT mint (POST /api/v1/auth/wallet-verify) which
# enables private-table realtime via auth.jwt()->>'user_address' RLS (012).
# Heroku: `heroku config:set SUPABASE_JWT_SECRET=<jwt_secret>` — HS256.
# If unset, backend returns 503 and frontend falls back to polling (no instant push).
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret-hs256>
SUPABASE_JWT_EXPIRY_SECONDS=86400

# SEC-01: AES-256-GCM key for encrypting ephemeral session signing keys at rest
# (sessions.session_key_private_key holds ciphertext only). 64 hex chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_KEY_ENCRYPTION_KEY=<64-hex-chars-from-secure-random-generator>

# ------------------------------------------------------------------------------
# 4. Groq LLM (Primary Swarm Reasoning Engine - Supports Multi-Key Round-Robin Pool)
# ------------------------------------------------------------------------------
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=gsk_...<your-groq-api-key-1>
GROQ_API_KEY_2=gsk_...<your-groq-api-key-2>
GROQ_API_KEY_3=gsk_...<your-groq-api-key-3>
# Add up to GROQ_API_KEY_50 for continuous round-robin key rotation

# ------------------------------------------------------------------------------
# 5. Gemini LLM (Secondary Fallback Engine)
# ------------------------------------------------------------------------------
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=AIzaSy...<your-gemini-api-key>
GEMINI_MODEL=gemini-3.1-flash-lite

# ------------------------------------------------------------------------------
# 6. Somnia Shannon Testnet & Network Infrastructure
# ------------------------------------------------------------------------------
NETWORK=testnet
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
# Aliases honored by env.ts: RPC_URL (→ SOMNIA_RPC_URL), WS_RPC_URL (→ SOMNIA_WS_URL), PRIVATE_KEY (→ OPERATOR_PRIVATE_KEY)
SOMNIA_WS_URL=wss://api.infra.testnet.somnia.network/ws
INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
REST_API_URL=https://stg.api.dreamdex.io/v0
SOMNIA_CHAIN_ID=50312
OPERATOR_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 7. Canonical Somnia / DreamDEX Contract Addresses (SOMNIA_* overrides)
# ------------------------------------------------------------------------------
# Single source of truth for backend chain reads/writes (backend/src/config/somnia.ts).
# Rotate here (and via `heroku config:set -a dreampulse-backend`) on redeploy — no code edits needed.
SOMNIA_BINARY_MODULE=0x3ecC694Cef705358864a646142ac17A90E29e388
SOMNIA_MARKETS_CORE=0x2802504314685D89bF6C992CA5a8e7cC78bc0294
SOMNIA_CLOB_FACTORY=0xb2BE8EE02F96379DB75f01802384593EBa9bfF04
SOMNIA_BINARY_POOL_IMPL=0x82A1FcdaA2daC2fC7D5f9909D43E68021eE966FD
SOMNIA_BINARY_SETTLEMENT=0xbF4a49e0Dfd092e5FBE8E5761064C49533e6Ed23
SOMNIA_COLLATERAL_ROUTER=0xbC0C9834B15ACE38bB50dDaa7d7f7C7CC4DC183C
SOMNIA_MARKET_CREATOR_FACTORY=0xE6bEE93cE87c9E6e62aCb621caa7832EE47b4F6B
SOMNIA_ORACLE_HUB=0xe40db387cC98601Dd11bd634fF2f3AD5686dE32b
SOMNIA_MARKET_CREATOR=0x5Ce69567dB39C8fBAd7e048bEfdbcCdfE67B44e6
SOMNIA_TEST_USDC=0x70a86D8842FB63C4Ad2b7cdddF530eBf1BB25d8E
# DreamPulse session contracts (SEC-03 hardened generation)
SOMNIA_SESSION_ACCOUNT=0xa85ec9a6A0845eeb642E1DCE12780E9b4cFD37F8
SOMNIA_SESSION_ACCOUNT_IMPL=0x6177d1E24C838789c1367fC9B66Bcf689C6ff60F
SOMNIA_SESSION_ACCOUNT_FACTORY=0xA0C2eaAe0438bCB6DD0FA2Cc2317BEDB8Ff25e94
# Pre-SEC-03 factory, kept for migration grace-period checks only
SOMNIA_SESSION_ACCOUNT_FACTORY_LEGACY=0xf45589660652962a381c8420125bc4be90362081

# ------------------------------------------------------------------------------
# 7. DreamDEX Protocol Contracts (Somnia Shannon Testnet - Chain ID 50312)
# ------------------------------------------------------------------------------
DREAMDEX_REGISTRY_ADDRESS=0x3ecC694Cef705358864a646142ac17A90E29e388
OPERATOR_PERMISSIONS_REGISTRY_ADDRESS=0x15C7e8CE38F021c5b45d098AaD788f63090bF20A
DREAMDEX_VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

# ------------------------------------------------------------------------------
# 8. Optional Quantization Overrides (Micro-ticks & Lot precision)
# ------------------------------------------------------------------------------
# MM_TICK=1000
# MM_LOT=1000

# ------------------------------------------------------------------------------
# 9. Local vs Production Swarm Execution Control (Prevent Order Duplication)
# ------------------------------------------------------------------------------
# When developing locally while Heroku is running, set this to false (or DISABLE_SWARM_RUNNER=true)
# to prevent local backend from running autonomous trading loops and competing for on-chain nonces.
ENABLE_SWARM_RUNNER=true
# DISABLE_SWARM_RUNNER=false
# DRY_RUN_MODE=false
# Debug routes are disabled in production unless explicitly enabled:
# ENABLE_DEBUG_ROUTES=false

